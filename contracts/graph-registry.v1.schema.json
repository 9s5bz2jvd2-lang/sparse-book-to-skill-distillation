{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-registry.v1",
  "title": "Deterministic graph-sparse registry: atomic node index, dependency graph, scoped safety policy, and vector sidecar binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "graph_id",
    "base_registry_id",
    "base_build_id",
    "base_registry_sha256",
    "source_manifest_sha256",
    "atom_coverage_sha256",
    "atomic_nodes",
    "dependency_edges",
    "domain_index",
    "routing_policy",
    "safety_config",
    "provenance_revisit_policy",
    "vector_config"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "graph_id": {"type": "string", "pattern": "^graph-[0-9a-f]{16}$"},
    "base_registry_id": {"type": "string"},
    "base_build_id": {"type": "string"},
    "base_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "atom_coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "atomic_nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id", "node_kind", "expert_id", "routing_priority", "title",
          "one_liner", "trigger_terms", "anti_triggers", "safety_red_lines",
          "validation_state", "global_invariant", "risk_domains",
          "atom_path", "atom_sha256", "l3_path", "chunk_ids"
        ],
        "properties": {
          "node_id": {"type": "string"},
          "node_kind": {"type": "string"},
          "expert_id": {"type": "string"},
          "routing_priority": {"type": "integer", "minimum": 0},
          "title": {"type": "string"},
          "one_liner": {"type": "string"},
          "trigger_terms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["term", "weight"],
              "properties": {
                "term": {"type": "string"},
                "weight": {"type": "integer", "minimum": 1, "maximum": 20}
              }
            }
          },
          "anti_triggers": {"type": "array", "items": {"type": "string"}},
          "safety_red_lines": {"type": "array", "items": {"type": "string"}},
          "validation_state": {"type": "string"},
          "global_invariant": {"type": "boolean"},
          "risk_domains": {"type": "array", "items": {"type": "string"}},
          "atom_path": {"type": "string"},
          "atom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "l3_path": {"type": "string"},
          "chunk_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_node_id", "target_node_id", "edge_origin", "relation_type", "reason"],
        "properties": {
          "source_node_id": {"type": "string"},
          "target_node_id": {"type": "string"},
          "edge_origin": {"enum": ["dependency", "relation"]},
          "relation_type": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "domain_index": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_score", "default_top_k", "max_top_k", "vector_top_k", "max_closure_nodes", "revisit_top_k"],
      "properties": {
        "minimum_score": {"type": "integer", "minimum": 1},
        "default_top_k": {"type": "integer", "minimum": 1},
        "max_top_k": {"type": "integer", "minimum": 1},
        "vector_top_k": {"type": "integer", "minimum": 1},
        "max_closure_nodes": {"type": "integer", "minimum": 1},
        "revisit_top_k": {"type": "integer", "minimum": 1}
      }
    },
    "safety_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_checks", "global_invariant_node_ids", "risk_domain_index"],
      "properties": {
        "baseline_checks": {"type": "array", "items": {"type": "string"}},
        "global_invariant_node_ids": {"type": "array", "items": {"type": "string"}},
        "risk_domain_index": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "provenance_revisit_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retain_query_context", "trace_expansion_reasons", "residual_bank_supported"],
      "properties": {
        "retain_query_context": {"type": "boolean"},
        "trace_expansion_reasons": {"type": "boolean"},
        "residual_bank_supported": {"type": "boolean"}
      }
    },
    "vector_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vector_routing", "default_backend", "channels", "vector_index_path", "vector_index_sha256"],
      "properties": {
        "vector_routing": {"enum": ["disabled", "optional", "required"]},
        "default_backend": {"enum": ["none", "local_model", "sidecar_index"]},
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel_name", "dimension", "model_id", "model_version", "weight"],
            "properties": {
              "channel_name": {"type": "string"},
              "dimension": {"type": "integer", "minimum": 1},
              "model_id": {"type": "string"},
              "model_version": {"type": "string"},
              "weight": {"type": "number"}
            }
          }
        },
        "vector_index_path": {"type": "string"},
        "vector_index_sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"}
      }
    }
  }
}
