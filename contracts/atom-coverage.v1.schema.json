{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atom-coverage.v1",
  "title": "Authored atomic-coverage declaration: every reusable chunk is atom-covered or reviewed as having no atomizable content",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source_manifest_sha256", "authored_by", "entries"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authored_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_type", "author_label"],
      "properties": {
        "author_type": {"enum": ["agent", "human"]},
        "author_label": {"type": "string", "minLength": 1}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "status", "atom_ids", "reason"],
        "properties": {
          "chunk_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "atoms_authored", "no_atomizable_content"]},
          "atom_ids": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
