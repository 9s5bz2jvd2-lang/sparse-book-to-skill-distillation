{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "composition-manifest.v1",
  "title": "Micro-model composition manifest for locally instantiable Skill model system",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "manifest_id",
    "manifest_version",
    "member_skills",
    "shared_core",
    "router_policy",
    "serial_edges",
    "parallel_groups",
    "graph_shared_edges",
    "required_schemas",
    "safety_policy",
    "evaluation_fixtures",
    "version_hashes"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string"},
    "manifest_version": {"type": "string"},
    "member_skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "role", "graph_registry_path", "input_schema", "output_schema"],
        "properties": {
          "skill_id": {"type": "string"},
          "role": {"type": "string", "minLength": 1},
          "graph_registry_path": {"type": "string"},
          "input_schema": {"type": "string"},
          "output_schema": {"type": "string"}
        }
      }
    },
    "shared_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "router_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_type", "stages"],
      "properties": {
        "policy_type": {"const": "two_stage_sparse_graph"},
        "stages": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage_id", "description"],
            "properties": {
              "stage_id": {"type": "string"},
              "description": {"type": "string"}
            }
          }
        }
      }
    },
    "serial_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_skill", "to_skill", "interface_contract", "fields_carried"],
        "properties": {
          "from_skill": {"type": "string"},
          "to_skill": {"type": "string"},
          "interface_contract": {"type": "string"},
          "fields_carried": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "parallel_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "skill_ids", "join_policy"],
        "properties": {
          "group_id": {"type": "string"},
          "skill_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "join_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy_type"],
            "properties": {
              "policy_type": {"enum": ["union", "majority_vote", "all_must_agree", "preserve_dissent"]},
              "conflict_resolution": {"type": "string"}
            }
          }
        }
      }
    },
    "graph_shared_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shared_node_id", "referenced_by_skills", "invariant"],
        "properties": {
          "shared_node_id": {"type": "string"},
          "referenced_by_skills": {"type": "array", "items": {"type": "string"}},
          "invariant": {"type": "string"}
        }
      }
    },
    "required_schemas": {"type": "array", "items": {"type": "string"}},
    "safety_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_expand_safety_nodes", "fail_closed_on_missing"],
      "properties": {
        "must_expand_safety_nodes": {"type": "array", "items": {"type": "string"}},
        "fail_closed_on_missing": {"type": "boolean"}
      }
    },
    "evaluation_fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "path"],
        "properties": {
          "fixture_id": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "version_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
