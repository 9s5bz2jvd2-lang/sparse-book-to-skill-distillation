{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-review.v2",
  "title": "Human/agent-authored source-grounded semantic review attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "review_status", "source_manifest_sha256", "reviewer", "review_method", "reviewed_chunk_ids", "criteria", "limitations", "review_assertion", "semantic_quality_not_automated"],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "review_status": {"enum": ["pending", "complete"]},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_type", "reviewer_label"],
      "properties": {
        "reviewer_type": {"enum": ["human", "agent", "human_and_agent"]},
        "reviewer_label": {"type": "string", "minLength": 1}
      }
    },
    "review_method": {"const": "entire_chunk_read_with_source_locator_verification"},
    "reviewed_chunk_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims_source_grounded", "meaning_faithful", "uncertainty_recorded", "routing_terms_reviewed", "l3_usefulness_reviewed"],
      "properties": {
        "claims_source_grounded": {"type": "boolean"},
        "meaning_faithful": {"type": "boolean"},
        "uncertainty_recorded": {"type": "boolean"},
        "routing_terms_reviewed": {"type": "boolean"},
        "l3_usefulness_reviewed": {"type": "boolean"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review_assertion": {"type": "string", "minLength": 20},
    "semantic_quality_not_automated": {"const": true}
  }
}
