{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query-request.v2",
  "title": "Sparse read query request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "query_id", "query", "risk_domains"],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "query_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "query": {"type": "string", "minLength": 1, "maxLength": 4000},
    "risk_domains": {"type": "array", "uniqueItems": true, "items": {"enum": ["medical", "nutrition", "legal", "financial", "copyright", "privacy"]}},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 8}
  }
}
