{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-state.v2",
  "title": "Durable ordered semantic-review batching state",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source_manifest_sha256", "queue_plan_sha256", "batch_size", "completed_chunk_ids", "active_batch_id", "active_chunk_ids", "all_chunks_checkpointed"],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "queue_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 1000},
    "completed_chunk_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "active_batch_id": {"type": "string"},
    "active_chunk_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "all_chunks_checkpointed": {"type": "boolean"}
  }
}
