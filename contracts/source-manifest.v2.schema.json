{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-manifest.v2",
  "title": "Complete local source intake manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "manifest_id", "source_label", "full_text_status", "chunking", "limits", "sources", "chunks"],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "manifest_id": {"type": "string", "pattern": "^manifest-[0-9a-f]{20}$"},
    "source_label": {"type": "string", "minLength": 1},
    "full_text_status": {"const": "complete"},
    "chunking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "max_lines_per_chunk"],
      "properties": {
        "strategy": {"const": "fixed_lines_v1"},
        "max_lines_per_chunk": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files", "max_source_bytes", "max_total_bytes"],
      "properties": {
        "max_files": {"type": "integer", "minimum": 1},
        "max_source_bytes": {"type": "integer", "minimum": 1},
        "max_total_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "relative_path", "source_kind", "full_text_status", "source_sha256", "original_path", "text_sha256", "text_path", "line_count", "chunk_ids"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^src-[0-9a-f]{16}$"},
          "relative_path": {"type": "string", "minLength": 1},
          "source_kind": {"enum": ["utf8_text", "utf8_markdown", "pdf_pdftotext"]},
          "full_text_status": {"enum": ["complete_utf8", "complete_pdftotext"]},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "original_path": {"type": "string", "minLength": 1},
          "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "text_path": {"type": "string", "minLength": 1},
          "line_count": {"type": "integer", "minimum": 1},
          "chunk_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "source_id", "source_path", "path", "sha256", "start_line", "end_line", "page_range"],
        "properties": {
          "chunk_id": {"type": "string", "pattern": "^chunk-[0-9a-f]{20}$"},
          "source_id": {"type": "string"},
          "source_path": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "page_range": {"type": "array", "items": {"type": "integer", "minimum": 1}}
        }
      }
    }
  }
}
