{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "residual-bank.v1",
  "title": "Versioned workflow-level residual memory: append-only record of nodes selected by earlier stages",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "bank_version", "graph_id", "entries"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "bank_version": {"type": "integer", "minimum": 1},
    "graph_id": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "query_id", "node_id", "selection_reason"],
        "properties": {
          "stage_id": {"type": "string", "minLength": 1},
          "query_id": {"type": "string", "minLength": 1},
          "node_id": {"type": "string", "minLength": 1},
          "selection_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
