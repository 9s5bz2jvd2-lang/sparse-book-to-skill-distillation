{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-map.v2",
  "title": "Validated mapping from every source chunk to semantic artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source_manifest_sha256", "full_text_status", "entries"],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "full_text_status": {"const": "complete"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "artifact_path", "processing_status", "node_ids"],
        "properties": {
          "chunk_id": {"type": "string"},
          "artifact_path": {"type": "string"},
          "processing_status": {"enum": ["complete", "complete_no_reusable_knowledge"]},
          "node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
